<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculatorV1.MainPage">
    <Grid RowDefinitions="40, 80, *" RowSpacing="0" ColumnDefinitions="*" BackgroundColor="#222">
        <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="#222">
            <VerticalStackLayout VerticalOptions="Start" Padding="20, 15, 15, 15">
                <Label x:Name="operationDisplay"
                       Text=""
                       FontSize="20"
                       HorizontalOptions="Start"
                       TextColor="Grey"/>
            </VerticalStackLayout>
        </Border>
        <Border Grid.Row="1" StrokeThickness="0" BackgroundColor="#222" Padding="15, 15, 15, 0">
            <VerticalStackLayout VerticalOptions="End">
                <Label x:Name="resultDisplay"
                   Text="0"
                   FontSize="40"
                   HorizontalTextAlignment="End"
                   TextColor="White"/>
            </VerticalStackLayout>
        </Border>
        <Grid Grid.Row="2"
              RowDefinitions="*,*,*,*,*"
              ColumnDefinitions="*,*,*,*,*"
              RowSpacing="10"
              ColumnSpacing="10"
              Padding="20">

            <Button Grid.Row="0" Grid.Column="0" FontSize="20" Text="C" Clicked="clearDisplay"/>
            <Button Grid.Row="0" Grid.Column="1" FontSize="20" Text="7" Clicked="numberPressed"/>
            <Button Grid.Row="0" Grid.Column="2" FontSize="20" Text="8" Clicked="numberPressed"/>
            <Button Grid.Row="0" Grid.Column="3" FontSize="20" Text="9" Clicked="numberPressed"/>
            <Button Grid.Row="0" Grid.Column="4" FontSize="20" Text="/" Clicked="operatorPressed"/>

            <Button Grid.Row="1" Grid.Column="0" FontSize="20" Text="√" Clicked="unaryOperation"/>
            <Button Grid.Row="1" Grid.Column="1" FontSize="20" Text="4" Clicked="numberPressed"/>
            <Button Grid.Row="1" Grid.Column="2" FontSize="20" Text="5" Clicked="numberPressed"/>
            <Button Grid.Row="1" Grid.Column="3" FontSize="20" Text="6" Clicked="numberPressed"/>
            <Button Grid.Row="1" Grid.Column="4" FontSize="20" Text="*" Clicked="operatorPressed"/>

            <Button Grid.Row="2" Grid.Column="0" FontSize="20" Text="^" Clicked="operatorPressed"/>
            <Button Grid.Row="2" Grid.Column="1" FontSize="20" Text="1" Clicked="numberPressed"/>
            <Button Grid.Row="2" Grid.Column="2" FontSize="20" Text="2" Clicked="numberPressed"/>
            <Button Grid.Row="2" Grid.Column="3" FontSize="20" Text="3" Clicked="numberPressed"/>
            <Button Grid.Row="2" Grid.Column="4" FontSize="20" Text="-" Clicked="operatorPressed"/>

            <Button Grid.Row="3" Grid.Column="0" FontSize="20" Text="ln" Clicked="unaryOperation"/>
            <Button Grid.Row="3" Grid.Column="1" FontSize="20"  Text="0" Clicked="numberPressed"/>
            <Button Grid.Row="3" Grid.Column="2" FontSize="20" Text="." Clicked="decimalPoint"/>
            <Button Grid.Row="3" Grid.Column="3" FontSize="20" Text="=" Clicked="equals"/>
            <Button Grid.Row="3" Grid.Column="4" FontSize="20" Text="+" Clicked="operatorPressed"/>

        </Grid>
    </Grid>

</ContentPage>
