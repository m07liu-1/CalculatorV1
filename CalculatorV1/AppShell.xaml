<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CalculatorV1"
    xmlns:views="clr-namespace:CalculatorV1.Views" 
    x:Class="CalculatorV1.AppShell"
    Title="CalculatorV1"
    BackgroundColor="LightGrey">
    <!--To use secondary menu option, use <MenuFlyoutSubItem> under <MenuBarItem>-->
    <Shell.TitleView> <!-- Hides the title-->
        <Grid />
    </Shell.TitleView>
    <Shell.MenuBarItems>
        <MenuBarItem Text="Open" >
            <MenuFlyoutItem Text="Calculator" Clicked="openTab"/>
            <MenuFlyoutItem Text="Page 2" Clicked="openTab"/>
            <MenuFlyoutItem Text="Page 3" Clicked="openTab"/>
            <MenuFlyoutItem Text="Random Number Game" Clicked="openTab"/>
        </MenuBarItem>
        <MenuBarItem Text="File">
            <MenuFlyoutItem Text="Export"/>
            <MenuFlyoutSubItem Text="Save as">
                <MenuFlyoutItem Text="XAML File"/>
                <MenuFlyoutItem Text="PDF"/>
            </MenuFlyoutSubItem>
            <MenuFlyoutItem Text="Load" Clicked="Load"/>
        </MenuBarItem>
        <MenuBarItem Text="Tools">
            <MenuFlyoutItem Text="Aquarius Data Extraction" Clicked="openAQ"/>
        </MenuBarItem>
    </Shell.MenuBarItems>
    <TabBar x:Name="Tabs">
        <ShellContent
        Title="Calculator"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    </TabBar>
</Shell>
