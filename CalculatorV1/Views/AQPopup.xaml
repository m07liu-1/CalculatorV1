<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CalculatorV1.Views.AQPopup"
             CanBeDismissedByTappingOutsideOfPopup="False">
    <Grid>
        <VerticalStackLayout VerticalOptions="Center">
            <HorizontalStackLayout>
                <Label Text="Station Id: "/>
                <Entry x:Name="StationId"
               Placeholder="02KF015"/>
            </HorizontalStackLayout>
            <Grid RowDefinitions="auto, auto" ColumnDefinitions="auto, *">
                <Label Grid.Row="0"  Grid.Column="0" Text="Username: "/>
                <Entry Grid.Row="0" Grid.Column="1" x:Name="Username" Keyboard="Password" />
                <Label Grid.Row="1" Grid.Column="0" Text="Password: "/>
                <Entry Grid.Row="1" Grid.Column="1" x:Name="Password" Keyboard="Password" IsPassword="True"/>
            </Grid>
            <Label x:Name="Warning" Text="" TextColor="Red"/>
            <Label x:Name="Result" Text=""/>
            <HorizontalStackLayout HorizontalOptions="End">
                <Button Text="Run" Clicked="GetData"/>
                <Button Text="Close" Clicked="ClosePopup"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</toolkit:Popup>