<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculatorV1.Views.PageThree"
             Title="PageThree">
    <VerticalStackLayout>
        <Label Text="The average of the two numbers is: "/>
        <Label x:Name="receiver"
            Text="{Binding _vm.Average}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Entry x:Name="testEntry"
               Text="{Binding ToBeSaved}"
               Keyboard="Numeric"
               Placeholder="save a number.."
               Unfocused="OnEntryCompleted"/>
    </VerticalStackLayout>
</ContentPage>