<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CalculatorV1.Views.DataPopup"
             CanBeDismissedByTappingOutsideOfPopup="true">
    <VerticalStackLayout>
        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="Auto,Auto" Padding="20">
            <Entry Grid.Row="0" Grid.Column="0" x:Name="A00" Keyboard="Numeric" TextChanged="ChangeColor"/>
            <Entry Grid.Row="0" Grid.Column="1" x:Name="A01" Keyboard="Numeric" TextChanged="ChangeColor"/>
            <Entry Grid.Row="1" Grid.Column="0" x:Name="A10" Keyboard="Numeric" TextChanged="ChangeColor"/>
            <Entry Grid.Row="1" Grid.Column="1" x:Name="A11" Keyboard="Numeric" TextChanged="ChangeColor"/>
        </Grid>
        <Button Text="Calculate Determinant" Clicked="FindDet"/>
        <Label x:Name="Result" Text=""/>
    </VerticalStackLayout>
</toolkit:Popup>